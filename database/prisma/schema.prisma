// ECOFlow Prisma Schema
// Provider: PostgreSQL (Supabase)
// Architecture Reference: Milestone 2.6 Relational Specification (Corrected Milestone 3.1.1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// Enums (Reconciled with @ecoflow/domain-types)
// ==============================================================================

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductCategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BOMStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BOMComponentType {
  RAW_MATERIAL
  SUB_ASSEMBLY
  HARDWARE
  ELECTRONIC
  MECHANICAL
  ELECTRICAL
  OPTICAL
  CHEMICAL
  FASTENER
  PLASTIC_MOLDED
  SHEET_METAL
  CONSUMABLE
  LABEL_PRINTING
  CABLE_WIRE
  TOOLING
  SOFTWARE_FIRMWARE
  PACKAGING
  OTHER
}

enum ECOStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ECRRequestType {
  DEFECT
  IMPROVEMENT
  COST_REDUCTION
  SAFETY
  OTHER
}

enum ECRStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  ACCEPTED
  REJECTED
  PROMOTED
}

enum ECNStatus {
  DRAFT
  ISSUED
  COMPLETED
  CANCELLED
}

enum ECNDepartment {
  ENGINEERING
  QUALITY
  PRODUCTION
  PROCUREMENT
  INVENTORY
  MANAGEMENT
}

enum ECNAcknowledgementStatus {
  PENDING
  ACKNOWLEDGED
}

enum MaterialDispositionType {
  SCRAP
  REWORK
  USE_AS_IS
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeType {
  QUANTITY_CHANGE
  MATERIAL_CHANGE
  COST_CHANGE
  COMPONENT_ADDITION
  COMPONENT_REMOVAL
  SPECIFICATION_CHANGE
}

enum ChangeTarget {
  PRODUCT
  BOM
  COMPONENT
}

enum ImpactType {
  COST
  MATERIAL
  MANUFACTURING
  QUALITY
  COMPLIANCE
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum VersionReleaseStatus {
  SCHEDULED
  RELEASED
  DEPRECATED
}

enum AuditSeverity {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum NotificationType {
  ECO_SUBMITTED
  ECO_APPROVED
  ECO_REJECTED
  APPROVAL_REQUESTED
  SYSTEM_ALERT
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  PENDING_QUALIFICATION
  BLOCKED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum InventoryTransactionType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  SCRAP
  TRANSFER
  RESERVATION
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum WorkOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionType {
  RECEIVING
  IN_PROCESS
  FINAL
  FIRST_ARTICLE
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  CONDITIONALLY_PASSED
}

enum NCRSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum NCRStatus {
  OPEN
  UNDER_INVESTIGATION
  CAPA_REQUIRED
  CLOSED
  REJECTED
}

// ==============================================================================
// Identity, Access & Session Management
// ==============================================================================

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique @db.VarChar(255)
  password_hash String     @db.VarChar(255)
  first_name    String     @db.VarChar(100)
  last_name     String     @db.VarChar(100)
  status        UserStatus @default(PENDING)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @updatedAt @db.Timestamptz(6)

  // Relationships
  user_roles            UserRole[]
  sessions              Session[]
  refresh_tokens        RefreshToken[]
  created_ecos          ECO[]               @relation("EcoCreator")
  assigned_ecos         ECO[]               @relation("EcoAssignee")
  eco_revisions_created ECORevision[]       @relation("EcoRevisionCreator")
  eco_comments          ECOComment[]
  eco_attachments       ECOAttachment[]
  approvals             Approval[]
  created_categories    ProductCategory[]   @relation("CategoryCreator")
  created_products      Product[]           @relation("ProductCreator")
  created_attachments   ProductAttachment[] @relation("ProductAttachmentCreator")
  created_boms          BOM[]               @relation("BomCreator")
  created_product_vers  ProductVersion[]    @relation("ProductVersionCreator")
  created_bom_vers      BOMVersion[]        @relation("BomVersionCreator")
  created_releases      VersionRelease[]    @relation("ReleaseCreator")
  submitted_ecrs        ECR[]               @relation("EcrSubmitter")
  assigned_ecrs         ECR[]               @relation("EcrAssignee")
  issued_ecns           ECN[]               @relation("EcnIssuer")
  created_ecns          ECN[]               @relation("EcnCreator")
  assigned_ecn_dists    ECNDistribution[]   @relation("EcnDistAssignee")
  acknowledged_ecn_dists ECNDistribution[]  @relation("EcnDistAcknowledger")
  created_ecn_disps     ECNMaterialDisposition[] @relation("EcnDispCreator")
  audit_logs            AuditLog[]
  login_audits          LoginAudit[]
  notifications         Notification[]
  idempotency_keys      IdempotencyKey[]
  created_suppliers     Supplier[]          @relation("SupplierCreator")
  created_pos           PurchaseOrder[]     @relation("POCreator")
  approved_pos          PurchaseOrder[]     @relation("POApprover")
  created_rfqs          RFQ[]               @relation("RFQCreator")
  created_quotations    SupplierQuotation[] @relation("QuotationCreator")
  negotiation_events    QuotationNegotiationEvent[] @relation("NegotiationActor")
  created_wos           WorkOrder[]         @relation("WOCreator")
  conducted_inspections QualityInspection[] @relation("InspectionInspector")
  created_ncrs          QualityNonConformance[] @relation("NCRCreator")
  assigned_ncrs         QualityNonConformance[] @relation("NCRAssignee")
  inventory_txs         InventoryTransaction[] @relation("InventoryTxPerformer")

  @@index([email])
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  // Relationships
  user_roles       UserRole[]
  role_permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  module      String   @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  // Relationships
  role_permissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  is_primary Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@unique([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
  @@map("user_roles")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Restrict)

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@index([permission_id])
  @@map("role_permissions")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  ip_address     String?   @db.VarChar(45)
  user_agent     String?   @db.Text
  is_revoked     Boolean   @default(false)
  revoked_at     DateTime? @db.Timestamptz(6)
  revoked_reason String?   @db.VarChar(255)
  expires_at     DateTime  @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)

  // Relations
  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_tokens RefreshToken[]

  @@index([user_id])
  @@index([expires_at])
  @@index([is_revoked])
  @@map("sessions")
}

model RefreshToken {
  id                   String    @id @default(uuid()) @db.Uuid
  session_id           String    @db.Uuid
  user_id              String    @db.Uuid
  token_hash           String    @unique @db.VarChar(255)
  token_family         String    @db.Uuid
  is_consumed          Boolean   @default(false)
  consumed_at          DateTime? @db.Timestamptz(6)
  replaced_by_token_id String?   @db.Uuid
  expires_at           DateTime  @db.Timestamptz(6)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  session           Session        @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  replaced_by_token RefreshToken?  @relation("TokenRotation", fields: [replaced_by_token_id], references: [id], onDelete: SetNull)
  preceding_tokens  RefreshToken[] @relation("TokenRotation")

  @@index([session_id])
  @@index([user_id])
  @@index([token_family])
  @@index([token_hash])
  @@map("refresh_tokens")
}

// ==============================================================================
// Product Management & Versioning
// ==============================================================================

model ProductCategory {
  id          String                @id @default(uuid()) @db.Uuid
  name        String                @unique @db.VarChar(100)
  code        String                @unique @db.VarChar(50)
  description String?               @db.Text
  status      ProductCategoryStatus @default(ACTIVE)
  created_by  String                @db.Uuid
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime              @updatedAt @db.Timestamptz(6)

  // Relations
  creator  User      @relation("CategoryCreator", fields: [created_by], references: [id], onDelete: Restrict)
  products Product[]

  @@index([status])
  @@map("product_categories")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  part_number     String        @unique @db.VarChar(100)
  name            String        @db.VarChar(255)
  description     String?       @db.Text
  category_id     String        @db.Uuid
  current_version Int           @default(1)
  status          ProductStatus @default(DRAFT)
  created_by      String        @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  // Relations
  category         ProductCategory     @relation(fields: [category_id], references: [id], onDelete: Restrict)
  creator          User                @relation("ProductCreator", fields: [created_by], references: [id], onDelete: Restrict)
  boms             BOM[]
  attachments      ProductAttachment[]
  ecos             ECO[]
  ecrs             ECR[]
  ecn_dispositions ECNMaterialDisposition[]
  product_versions ProductVersion[]
  bom_versions     BOMVersion[]
  version_releases VersionRelease[]
  supplier_products SupplierProduct[]
  inventory_items   InventoryItem[]
  purchase_order_lines PurchaseOrderLine[]
  rfq_items         RFQItem[]
  supplier_quotations SupplierQuotation[]
  work_orders       WorkOrder[]
  work_order_allocations WorkOrderAllocation[]
  quality_inspections QualityInspection[]
  quality_non_conformances QualityNonConformance[]

  @@index([category_id])
  @@index([status])
  @@map("products")
}

model ProductAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  product_id String   @db.Uuid
  file_name  String   @db.VarChar(255)
  file_path  String   @db.VarChar(500)
  file_size  BigInt   @db.BigInt
  mime_type  String   @db.VarChar(100)
  created_by String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  creator User    @relation("ProductAttachmentCreator", fields: [created_by], references: [id], onDelete: Restrict)

  @@index([product_id])
  @@map("product_attachments")
}

// ==============================================================================
// Bill of Materials (BOM) & Components
// ==============================================================================

model BOM {
  id              String    @id @default(uuid()) @db.Uuid
  bom_number      String    @unique @db.VarChar(100)
  product_id      String    @db.Uuid
  current_version Int       @default(1)
  status          BOMStatus @default(DRAFT)
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  // Relations
  product              Product        @relation(fields: [product_id], references: [id], onDelete: Restrict)
  creator              User           @relation("BomCreator", fields: [created_by], references: [id], onDelete: Restrict)
  components           BOMComponent[] @relation("ParentBOMComponents")
  parent_usages        BOMComponent[] @relation("SubAssemblyUsages")
  ecos                 ECO[]
  ecrs                 ECR[]
  bom_versions         BOMVersion[]   @relation("BomToVersions")
  work_orders          WorkOrder[]
  quality_inspections  QualityInspection[]

  // Composite candidate key to support composite FK from BOMVersion(bom_id, product_id) and ECO(bom_id, product_id)
  @@unique([id, product_id])
  @@index([product_id])
  @@index([status])
  @@map("boms")
}

model BOMComponent {
  id                   String           @id @default(uuid()) @db.Uuid
  bom_id               String           @db.Uuid
  sub_assembly_bom_id  String?          @db.Uuid
  sub_assembly_version Int?
  part_number          String           @db.VarChar(100)
  name                 String           @db.VarChar(255)
  component_type       BOMComponentType @default(RAW_MATERIAL)
  quantity             Decimal          @db.Decimal(12, 4)
  unit_of_measure      String           @db.VarChar(50)
  unit_cost            Decimal          @db.Decimal(12, 2)
  total_cost           Decimal          @db.Decimal(14, 2)
  is_cost_overridden   Boolean          @default(false)
  cost_override_reason String?          @db.Text
  notes                String?          @db.Text
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @updatedAt @db.Timestamptz(6)

  // Relations
  bom              BOM         @relation("ParentBOMComponents", fields: [bom_id], references: [id], onDelete: Cascade)
  sub_assembly_bom BOM?        @relation("SubAssemblyUsages", fields: [sub_assembly_bom_id], references: [id], onDelete: Restrict)
  pinned_version   BOMVersion? @relation("PinnedSubAssemblyVersion", fields: [sub_assembly_bom_id, sub_assembly_version], references: [bom_id, version_number], onDelete: Restrict)

  @@index([bom_id])
  @@index([sub_assembly_bom_id])
  @@index([sub_assembly_bom_id, sub_assembly_version])
  @@index([part_number])
  @@map("bom_components")
}

// ==============================================================================
// Engineering Change Orders (ECO) & Revisions
// ==============================================================================

model ECO {
  id                  String        @id @default(uuid()) @db.Uuid
  eco_number          String        @unique @db.VarChar(100)
  title               String        @db.VarChar(255)
  description         String?       @db.Text
  product_id          String        @db.Uuid
  bom_id              String        @db.Uuid
  active_revision_no  Int           @default(1)
  priority            PriorityLevel @default(MEDIUM)
  status              ECOStatus     @default(DRAFT)
  effective_date      DateTime?     @db.Timestamptz(6)
  rejection_reason    String?       @db.Text
  cancellation_reason String?       @db.Text
  created_by          String        @db.Uuid
  assigned_to         String?       @db.Uuid
  ecr_id              String?       @unique @db.Uuid
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @updatedAt @db.Timestamptz(6)

  // Relations
  product           Product          @relation(fields: [product_id], references: [id], onDelete: Restrict)
  bom               BOM              @relation(fields: [bom_id, product_id], references: [id, product_id], onDelete: Restrict)
  creator           User             @relation("EcoCreator", fields: [created_by], references: [id], onDelete: Restrict)
  assignee          User?            @relation("EcoAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  promoted_from_ecr ECR?             @relation("EcrPromotedEco")
  originating_ecr   ECR?             @relation("EcoOriginatingEcr", fields: [ecr_id], references: [id], onDelete: SetNull)
  eco_revisions     ECORevision[]
  eco_changes       ECOChange[]
  eco_comments      ECOComment[]
  eco_attachments   ECOAttachment[]
  approvals         Approval[]
  product_versions  ProductVersion[]
  bom_versions      BOMVersion[]
  version_releases  VersionRelease[]
  ecn               ECN?

  @@index([product_id])
  @@index([bom_id])
  @@index([status])
  @@index([created_by])
  @@index([assigned_to])
  @@index([ecr_id])
  @@map("ecos")
}

model ECORevision {
  eco_id          String    @db.Uuid
  revision_number Int       @default(1)
  status          ECOStatus @default(DRAFT)
  change_summary  String    @db.Text
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  // Relations
  eco              ECO                  @relation(fields: [eco_id], references: [id], onDelete: Restrict)
  creator          User                 @relation("EcoRevisionCreator", fields: [created_by], references: [id], onDelete: Restrict)
  changes          ECOChange[]
  snapshot         ECORevisionSnapshot?
  approval         Approval?
  product_versions ProductVersion[]
  bom_versions     BOMVersion[]

  @@id([eco_id, revision_number])
  @@index([created_by])
  @@index([status])
  @@map("eco_revisions")
}

model ECOChange {
  id              String       @id @default(uuid()) @db.Uuid
  eco_id          String       @db.Uuid
  revision_number Int
  change_type     ChangeType
  change_target   ChangeTarget @default(COMPONENT)
  field_name      String       @db.VarChar(100)
  old_value       String?      @db.Text
  new_value       String?      @db.Text
  impact_type     ImpactType   @default(MATERIAL)
  justification   String?      @db.Text
  created_at      DateTime     @default(now()) @db.Timestamptz(6)

  // Relations
  eco      ECO         @relation(fields: [eco_id], references: [id], onDelete: Restrict)
  revision ECORevision @relation(fields: [eco_id, revision_number], references: [eco_id, revision_number], onDelete: Restrict)

  @@index([eco_id, revision_number])
  @@index([eco_id])
  @@map("eco_changes")
}

model ECORevisionSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  eco_id          String   @db.Uuid
  revision_number Int
  snapshot_data   Json     @db.JsonB
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  revision ECORevision @relation(fields: [eco_id, revision_number], references: [eco_id, revision_number], onDelete: Restrict)

  @@unique([eco_id, revision_number])
  @@map("eco_revision_snapshots")
}

model ECOComment {
  id         String   @id @default(uuid()) @db.Uuid
  eco_id     String   @db.Uuid
  user_id    String   @db.Uuid
  comment    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  eco  ECO  @relation(fields: [eco_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([eco_id])
  @@index([user_id])
  @@map("eco_comments")
}

model ECOAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  eco_id     String   @db.Uuid
  file_name  String   @db.VarChar(255)
  file_path  String   @db.VarChar(500)
  file_size  BigInt   @db.BigInt
  mime_type  String   @db.VarChar(100)
  created_by String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  eco     ECO  @relation(fields: [eco_id], references: [id], onDelete: Cascade)
  creator User @relation(fields: [created_by], references: [id], onDelete: Restrict)

  @@index([eco_id])
  @@map("eco_attachments")
}

// ==============================================================================
// Engineering Change Requests (ECR)
// ==============================================================================

model ECR {
  id                   String         @id @default(uuid()) @db.Uuid
  ecr_number           String         @unique @db.VarChar(100)
  title                String         @db.VarChar(255)
  description          String         @db.Text
  request_type         ECRRequestType
  priority             PriorityLevel  @default(MEDIUM)
  status               ECRStatus      @default(SUBMITTED)
  product_id           String?        @db.Uuid
  bom_id               String?        @db.Uuid
  submitted_by         String         @db.Uuid
  assigned_to          String?        @db.Uuid
  affected_part_number String?        @db.VarChar(100)
  suggested_solution   String?        @db.Text
  review_comments      String?        @db.Text
  rejection_reason     String?        @db.Text
  promoted_eco_id      String?        @unique @db.Uuid
  submitted_at         DateTime       @default(now()) @db.Timestamptz(6)
  reviewed_at          DateTime?      @db.Timestamptz(6)
  created_at           DateTime       @default(now()) @db.Timestamptz(6)
  updated_at           DateTime       @updatedAt @db.Timestamptz(6)

  // Relations
  submitter            User           @relation("EcrSubmitter", fields: [submitted_by], references: [id], onDelete: Restrict)
  assignee             User?          @relation("EcrAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  product              Product?       @relation(fields: [product_id], references: [id], onDelete: SetNull)
  bom                  BOM?           @relation(fields: [bom_id], references: [id], onDelete: SetNull)
  promoted_eco         ECO?           @relation("EcrPromotedEco", fields: [promoted_eco_id], references: [id], onDelete: SetNull)
  originating_ecos     ECO[]          @relation("EcoOriginatingEcr")

  @@index([status])
  @@index([submitted_by])
  @@index([assigned_to])
  @@index([product_id])
  @@index([bom_id])
  @@map("ecrs")
}

// ==============================================================================
// Engineering Change Notices (ECN) & Distribution
// ==============================================================================

model ECN {
  id                  String        @id @default(uuid()) @db.Uuid
  ecn_number          String        @unique @db.VarChar(100)
  eco_id              String        @unique @db.Uuid
  version_release_id  String        @unique @db.Uuid
  title               String        @db.VarChar(255)
  change_summary      String        @db.Text
  reason_for_change   String?       @db.Text
  effective_date      DateTime      @db.Timestamptz(6)
  status              ECNStatus     @default(DRAFT)
  issued_by           String?       @db.Uuid
  issued_at           DateTime?     @db.Timestamptz(6)
  completed_at        DateTime?     @db.Timestamptz(6)
  cancelled_at        DateTime?     @db.Timestamptz(6)
  cancellation_reason String?       @db.Text
  created_by          String        @db.Uuid
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @updatedAt @db.Timestamptz(6)

  // Relations
  eco                 ECO           @relation(fields: [eco_id], references: [id], onDelete: Restrict)
  version_release     VersionRelease @relation(fields: [version_release_id], references: [id], onDelete: Restrict)
  issuer              User?         @relation("EcnIssuer", fields: [issued_by], references: [id], onDelete: SetNull)
  creator             User          @relation("EcnCreator", fields: [created_by], references: [id], onDelete: Restrict)
  distributions       ECNDistribution[]
  dispositions        ECNMaterialDisposition[]

  @@index([status])
  @@index([effective_date])
  @@index([created_by])
  @@map("ecns")
}

model ECNDistribution {
  id                     String                   @id @default(uuid()) @db.Uuid
  ecn_id                 String                   @db.Uuid
  department             ECNDepartment
  assigned_to            String?                  @db.Uuid
  acknowledgement_status ECNAcknowledgementStatus @default(PENDING)
  acknowledged_by        String?                  @db.Uuid
  acknowledged_at        DateTime?                @db.Timestamptz(6)
  comments               String?                  @db.Text
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @updatedAt @db.Timestamptz(6)

  // Relations
  ecn                    ECN                      @relation(fields: [ecn_id], references: [id], onDelete: Cascade)
  assignee               User?                    @relation("EcnDistAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  acknowledger           User?                    @relation("EcnDistAcknowledger", fields: [acknowledged_by], references: [id], onDelete: SetNull)

  @@unique([ecn_id, department])
  @@index([ecn_id])
  @@index([department])
  @@index([acknowledgement_status])
  @@map("ecn_distributions")
}

model ECNMaterialDisposition {
  id                     String                   @id @default(uuid()) @db.Uuid
  ecn_id                 String                   @db.Uuid
  product_id             String?                  @db.Uuid
  part_number            String?                  @db.VarChar(100)
  disposition_type       MaterialDispositionType
  quantity               Decimal?                 @db.Decimal(12, 4)
  instructions           String                   @db.Text
  responsible_department ECNDepartment
  created_by             String                   @db.Uuid
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @updatedAt @db.Timestamptz(6)

  // Relations
  ecn                    ECN                      @relation(fields: [ecn_id], references: [id], onDelete: Cascade)
  product                Product?                 @relation(fields: [product_id], references: [id], onDelete: SetNull)
  creator                User                     @relation("EcnDispCreator", fields: [created_by], references: [id], onDelete: Restrict)

  @@index([ecn_id])
  @@index([disposition_type])
  @@index([responsible_department])
  @@map("ecn_material_dispositions")
}

// ==============================================================================
// Approval Workflow
// ==============================================================================

model Approval {
  id              String           @id @default(uuid()) @db.Uuid
  eco_id          String           @db.Uuid
  revision_number Int
  approver_id     String           @db.Uuid
  decision        ApprovalDecision
  comments        String?          @db.Text
  decided_at      DateTime         @default(now()) @db.Timestamptz(6)

  // Relations
  eco      ECO         @relation(fields: [eco_id], references: [id], onDelete: Restrict)
  revision ECORevision @relation(fields: [eco_id, revision_number], references: [eco_id, revision_number], onDelete: Restrict)
  approver User        @relation(fields: [approver_id], references: [id], onDelete: Restrict)

  // A single formal decision is allowed per ECO revision
  @@unique([eco_id, revision_number])
  @@index([eco_id, revision_number])
  @@index([approver_id])
  @@map("approvals")
}

// ==============================================================================
// Immutable Versions & Version Releases
// ==============================================================================

model ProductVersion {
  id              String   @id @default(uuid()) @db.Uuid
  product_id      String   @db.Uuid
  version_number  Int
  eco_id          String   @db.Uuid
  revision_number Int
  snapshot_data   Json     @db.JsonB
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  product          Product          @relation(fields: [product_id], references: [id], onDelete: Restrict)
  eco              ECO              @relation(fields: [eco_id], references: [id], onDelete: Restrict)
  eco_revision     ECORevision      @relation(fields: [eco_id, revision_number], references: [eco_id, revision_number], onDelete: Restrict)
  creator          User             @relation("ProductVersionCreator", fields: [created_by], references: [id], onDelete: Restrict)
  version_releases VersionRelease[]

  // Composite candidate key to support composite FK from VersionRelease(product_version_id, product_id)
  @@unique([id, product_id])
  @@unique([product_id, version_number])
  @@index([product_id])
  @@index([eco_id, revision_number])
  @@map("product_versions")
}

model BOMVersion {
  id              String   @id @default(uuid()) @db.Uuid
  bom_id          String   @db.Uuid
  product_id      String   @db.Uuid
  version_number  Int
  eco_id          String   @db.Uuid
  revision_number Int
  snapshot_data   Json     @db.JsonB
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  bom              BOM              @relation("BomToVersions", fields: [bom_id, product_id], references: [id, product_id], onDelete: Restrict)
  product          Product          @relation(fields: [product_id], references: [id], onDelete: Restrict)
  eco              ECO              @relation(fields: [eco_id], references: [id], onDelete: Restrict)
  eco_revision     ECORevision      @relation(fields: [eco_id, revision_number], references: [eco_id, revision_number], onDelete: Restrict)
  creator          User             @relation("BomVersionCreator", fields: [created_by], references: [id], onDelete: Restrict)
  version_releases VersionRelease[]
  pinned_by_components BOMComponent[] @relation("PinnedSubAssemblyVersion")
  work_orders          WorkOrder[]

  // Composite candidate key to support composite FK from VersionRelease(bom_version_id, product_id)
  @@unique([id, product_id])
  @@unique([bom_id, version_number])
  @@index([bom_id])
  @@index([product_id])
  @@index([eco_id, revision_number])
  @@map("bom_versions")
}

model VersionRelease {
  id                 String               @id @default(uuid()) @db.Uuid
  eco_id             String               @db.Uuid
  product_id         String               @db.Uuid
  product_version_id String               @db.Uuid
  bom_version_id     String               @db.Uuid
  release_status     VersionReleaseStatus @default(RELEASED)
  released_by        String               @db.Uuid
  released_at        DateTime             @default(now()) @db.Timestamptz(6)

  // Relations
  eco             ECO            @relation(fields: [eco_id], references: [id], onDelete: Restrict)
  product         Product        @relation(fields: [product_id], references: [id], onDelete: Restrict)
  product_version ProductVersion @relation(fields: [product_version_id, product_id], references: [id, product_id], onDelete: Restrict)
  bom_version     BOMVersion     @relation(fields: [bom_version_id, product_id], references: [id, product_id], onDelete: Restrict)
  releaser        User           @relation("ReleaseCreator", fields: [released_by], references: [id], onDelete: Restrict)
  ecn             ECN?

  @@unique([eco_id])
  @@index([product_id])
  @@index([product_version_id])
  @@index([bom_version_id])
  @@index([released_by])
  @@map("version_releases")
}

// ==============================================================================
// Idempotency & Operation Concurrency
// ==============================================================================

model IdempotencyKey {
  id            String            @id @default(uuid()) @db.Uuid
  scope         String            @db.VarChar(100)
  key           String            @db.VarChar(255)
  actor_id      String            @db.Uuid
  resource_id   String?           @db.VarChar(100)
  request_hash  String            @db.VarChar(64)
  status        IdempotencyStatus @default(PROCESSING)
  response_body Json?             @db.JsonB
  lease_expires DateTime          @db.Timestamptz(6)
  claim_token   String            @db.Uuid
  completed_at  DateTime?         @db.Timestamptz(6)
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  updated_at    DateTime          @updatedAt @db.Timestamptz(6)

  // Relations
  actor User @relation(fields: [actor_id], references: [id], onDelete: Restrict)

  @@unique([scope, key])
  @@index([actor_id])
  @@index([scope, resource_id])
  @@index([lease_expires])
  @@map("idempotency_keys")
}

// ==============================================================================
// Auditing & Notifications
// ==============================================================================

model AuditLog {
  id          String        @id @default(uuid()) @db.Uuid
  user_id     String?       @db.Uuid
  action      String        @db.VarChar(100)
  entity_type String        @db.VarChar(100)
  entity_id   String        @db.VarChar(100)
  old_values  Json?         @db.JsonB
  new_values  Json?         @db.JsonB
  severity    AuditSeverity @default(INFO)
  ip_address  String?       @db.VarChar(45)
  user_agent  String?       @db.Text
  created_at  DateTime      @default(now()) @db.Timestamptz(6)

  // Relations
  user User? @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([entity_type, entity_id])
  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

model LoginAudit {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String?  @db.Uuid
  email_attempt  String   @db.VarChar(255)
  is_success     Boolean  @default(false)
  failure_reason String?  @db.VarChar(255)
  ip_address     String?  @db.VarChar(45)
  user_agent     String?  @db.Text
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  user User? @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id])
  @@index([email_attempt])
  @@index([created_at])
  @@map("login_audits")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  user_id    String           @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(255)
  message    String           @db.Text
  is_read    Boolean          @default(false)
  read_at    DateTime?        @db.Timestamptz(6)
  link       String?          @db.VarChar(500)
  created_at DateTime         @default(now()) @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@map("notifications")
}

// ==============================================================================
// Business Modules: Suppliers, Inventory, Purchasing, Manufacturing & Quality
// ==============================================================================

model Supplier {
  id            String         @id @default(uuid()) @db.Uuid
  supplier_code String         @unique @db.VarChar(50)
  name          String         @db.VarChar(255)
  status        SupplierStatus @default(ACTIVE)
  contact_name  String?        @db.VarChar(100)
  email         String?        @db.VarChar(255)
  phone         String?        @db.VarChar(50)
  address       String?        @db.Text
  rating        Decimal?       @default(5.00) @db.Decimal(3, 2)
  created_by    String?        @db.Uuid
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @updatedAt @db.Timestamptz(6)

  // Relations
  creator         User?             @relation("SupplierCreator", fields: [created_by], references: [id], onDelete: SetNull)
  products        SupplierProduct[]
  purchase_orders PurchaseOrder[]
  rfq_suppliers   RFQSupplier[]
  quotations      SupplierQuotation[]

  @@map("suppliers")
}

model SupplierProduct {
  id                   String   @id @default(uuid()) @db.Uuid
  supplier_id          String   @db.Uuid
  product_id           String   @db.Uuid
  supplier_part_number String?  @db.VarChar(100)
  lead_time_days       Int?     @default(7)
  unit_price           Decimal  @default(0.00) @db.Decimal(12, 2)
  minimum_order_qty    Decimal  @default(1.0000) @db.Decimal(12, 4)
  currency             String   @default("INR") @db.VarChar(10)
  is_preferred         Boolean  @default(false)
  status               String   @default("ACTIVE") @db.VarChar(20)
  valid_until          DateTime? @db.Timestamptz(6)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  supplier Supplier @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([supplier_id, product_id])
  @@map("supplier_products")
}

model Warehouse {
  id         String          @id @default(uuid()) @db.Uuid
  code       String          @unique @db.VarChar(50)
  name       String          @db.VarChar(255)
  location   String?         @db.VarChar(255)
  status     WarehouseStatus @default(ACTIVE)
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  updated_at DateTime        @updatedAt @db.Timestamptz(6)

  // Relations
  inventory_items InventoryItem[]

  @@map("warehouses")
}

model InventoryItem {
  id                String   @id @default(uuid()) @db.Uuid
  product_id        String   @db.Uuid
  warehouse_id      String   @db.Uuid
  quantity_on_hand  Decimal  @default(0.0000) @db.Decimal(12, 4)
  quantity_reserved Decimal  @default(0.0000) @db.Decimal(12, 4)
  min_threshold     Decimal  @default(0.0000) @db.Decimal(12, 4)
  max_threshold     Decimal? @db.Decimal(12, 4)
  unit_of_measure   String   @default("PCS") @db.VarChar(50)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  product      Product                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  warehouse    Warehouse              @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@unique([product_id, warehouse_id])
  @@map("inventory_items")
}

model InventoryTransaction {
  id             String                   @id @default(uuid()) @db.Uuid
  item_id        String                   @db.Uuid
  type           InventoryTransactionType
  quantity       Decimal                  @db.Decimal(12, 4)
  unit_cost      Decimal                  @default(0.00) @db.Decimal(12, 2)
  total_cost     Decimal                  @default(0.00) @db.Decimal(14, 2)
  reference_type String?                  @db.VarChar(50)
  reference_id   String?                  @db.Uuid
  notes          String?                  @db.Text
  performed_by   String                   @db.Uuid
  created_at     DateTime                 @default(now()) @db.Timestamptz(6)

  // Relations
  item      InventoryItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  performer User          @relation("InventoryTxPerformer", fields: [performed_by], references: [id], onDelete: Restrict)

  @@index([item_id])
  @@index([reference_id])
  @@map("inventory_transactions")
}

model PurchaseOrder {
  id                     String              @id @default(uuid()) @db.Uuid
  po_number              String              @unique @db.VarChar(50)
  supplier_id            String              @db.Uuid
  status                 PurchaseOrderStatus @default(DRAFT)
  order_date             DateTime            @default(now()) @db.Timestamptz(6)
  expected_delivery_date DateTime?           @db.Timestamptz(6)
  total_amount           Decimal             @default(0.00) @db.Decimal(14, 2)
  notes                  String?             @db.Text
  created_by             String              @db.Uuid
  approved_by            String?             @db.Uuid
  created_at             DateTime            @default(now()) @db.Timestamptz(6)
  updated_at             DateTime            @updatedAt @db.Timestamptz(6)

  // Relations
  supplier    Supplier            @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  creator     User                @relation("POCreator", fields: [created_by], references: [id], onDelete: Restrict)
  approver    User?               @relation("POApprover", fields: [approved_by], references: [id], onDelete: SetNull)
  lines       PurchaseOrderLine[]
  inspections QualityInspection[]
  quotations  SupplierQuotation[]

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                String   @id @default(uuid()) @db.Uuid
  po_id             String   @db.Uuid
  line_number       Int
  product_id        String   @db.Uuid
  quantity_ordered  Decimal  @db.Decimal(12, 4)
  quantity_received Decimal  @default(0.0000) @db.Decimal(12, 4)
  unit_price        Decimal  @db.Decimal(12, 2)
  total_price       Decimal  @db.Decimal(14, 2)
  unit_of_measure   String   @default("PCS") @db.VarChar(50)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  purchase_order PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@unique([po_id, line_number])
  @@map("purchase_order_lines")
}

model WorkOrder {
  id                 String          @id @default(uuid()) @db.Uuid
  wo_number          String          @unique @db.VarChar(50)
  product_id         String          @db.Uuid
  bom_id             String          @db.Uuid
  bom_version_id     String?         @db.Uuid
  target_quantity    Decimal         @db.Decimal(12, 4)
  completed_quantity Decimal         @default(0.0000) @db.Decimal(12, 4)
  rejected_quantity  Decimal         @default(0.0000) @db.Decimal(12, 4)
  status             WorkOrderStatus @default(DRAFT)
  start_date         DateTime?       @db.Timestamptz(6)
  end_date           DateTime?       @db.Timestamptz(6)
  created_by         String          @db.Uuid
  notes              String?         @db.Text
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @updatedAt @db.Timestamptz(6)

  // Relations
  product     Product               @relation(fields: [product_id], references: [id], onDelete: Restrict)
  bom         BOM                   @relation(fields: [bom_id], references: [id], onDelete: Restrict)
  bom_version BOMVersion?           @relation(fields: [bom_version_id], references: [id], onDelete: SetNull)
  creator     User                  @relation("WOCreator", fields: [created_by], references: [id], onDelete: Restrict)
  allocations WorkOrderAllocation[]
  inspections QualityInspection[]

  @@map("work_orders")
}

model WorkOrderAllocation {
  id                 String   @id @default(uuid()) @db.Uuid
  work_order_id      String   @db.Uuid
  product_id         String   @db.Uuid
  required_quantity  Decimal  @db.Decimal(12, 4)
  allocated_quantity Decimal  @default(0.0000) @db.Decimal(12, 4)
  consumed_quantity  Decimal  @default(0.0000) @db.Decimal(12, 4)
  unit_of_measure    String   @default("PCS") @db.VarChar(50)
  unit_cost          Decimal  @default(0.00) @db.Decimal(12, 2)
  total_cost         Decimal  @default(0.00) @db.Decimal(14, 2)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  work_order WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([work_order_id])
  @@map("work_order_allocations")
}

model QualityInspection {
  id                String           @id @default(uuid()) @db.Uuid
  inspection_number String           @unique @db.VarChar(50)
  type              InspectionType
  status            InspectionStatus @default(PENDING)
  product_id        String           @db.Uuid
  bom_id            String?          @db.Uuid
  work_order_id     String?          @db.Uuid
  po_id             String?          @db.Uuid
  inspector_id      String?          @db.Uuid
  sample_size       Decimal          @default(1.0000) @db.Decimal(12, 4)
  passed_quantity   Decimal          @default(0.0000) @db.Decimal(12, 4)
  failed_quantity   Decimal          @default(0.0000) @db.Decimal(12, 4)
  notes             String?          @db.Text
  conducted_at      DateTime?        @db.Timestamptz(6)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @updatedAt @db.Timestamptz(6)

  // Relations
  product          Product                 @relation(fields: [product_id], references: [id], onDelete: Restrict)
  bom              BOM?                    @relation(fields: [bom_id], references: [id], onDelete: SetNull)
  work_order       WorkOrder?              @relation(fields: [work_order_id], references: [id], onDelete: SetNull)
  purchase_order   PurchaseOrder?          @relation(fields: [po_id], references: [id], onDelete: SetNull)
  inspector        User?                   @relation("InspectionInspector", fields: [inspector_id], references: [id], onDelete: SetNull)
  non_conformances QualityNonConformance[]

  @@map("quality_inspections")
}

model QualityNonConformance {
  id            String      @id @default(uuid()) @db.Uuid
  ncr_number    String      @unique @db.VarChar(50)
  inspection_id String?     @db.Uuid
  product_id    String      @db.Uuid
  severity      NCRSeverity @default(MINOR)
  status        NCRStatus   @default(OPEN)
  title         String      @db.VarChar(255)
  description   String      @db.Text
  root_cause    String?     @db.Text
  disposition   String?     @db.VarChar(100)
  capa_plan     String?     @db.Text
  assigned_to   String?     @db.Uuid
  created_by    String      @db.Uuid
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @updatedAt @db.Timestamptz(6)

  // Relations
  inspection QualityInspection? @relation(fields: [inspection_id], references: [id], onDelete: SetNull)
  product    Product            @relation(fields: [product_id], references: [id], onDelete: Restrict)
  assignee   User?              @relation("NCRAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  creator    User               @relation("NCRCreator", fields: [created_by], references: [id], onDelete: Restrict)

  @@map("quality_non_conformances")
}

// ==============================================================================
// Procurement, RFQs & Supplier Quotations
// ==============================================================================

enum RFQStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum RFQSupplierStatus {
  INVITED
  RESPONDED
  DECLINED
}

enum SupplierQuotationStatus {
  DRAFT
  REQUESTED
  QUOTED
  COUNTER_OFFERED
  REVISED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum NegotiationEventType {
  COUNTER_OFFER
  REVISED_OFFER
  ACCEPTED
  REJECTED
}

model RFQ {
  id              String         @id @default(uuid()) @db.Uuid
  rfq_number      String         @unique @db.VarChar(50)
  title           String         @db.VarChar(255)
  status          RFQStatus      @default(OPEN)
  submission_date DateTime       @default(now()) @db.Timestamptz(6)
  deadline_date   DateTime?      @db.Timestamptz(6)
  delivery_date   DateTime?      @db.Timestamptz(6)
  notes           String?        @db.Text
  created_by      String         @db.Uuid
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @updatedAt @db.Timestamptz(6)

  // Relations
  creator         User                @relation("RFQCreator", fields: [created_by], references: [id], onDelete: Restrict)
  items           RFQItem[]
  suppliers       RFQSupplier[]
  quotations      SupplierQuotation[]

  @@index([status])
  @@map("rfqs")
}

model RFQItem {
  id                String   @id @default(uuid()) @db.Uuid
  rfq_id            String   @db.Uuid
  product_id        String   @db.Uuid
  quantity_required Decimal  @db.Decimal(12, 4)
  notes             String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  rfq     RFQ     @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([rfq_id])
  @@index([product_id])
  @@map("rfq_items")
}

model RFQSupplier {
  id          String            @id @default(uuid()) @db.Uuid
  rfq_id      String            @db.Uuid
  supplier_id String            @db.Uuid
  status      RFQSupplierStatus @default(INVITED)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)

  // Relations
  rfq      RFQ      @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplier_id], references: [id], onDelete: Cascade)

  @@unique([rfq_id, supplier_id], name: "uq_rfq_supplier")
  @@index([rfq_id])
  @@index([supplier_id])
  @@map("rfq_suppliers")
}

model SupplierQuotation {
  id                     String                  @id @default(uuid()) @db.Uuid
  quotation_number       String                  @unique @db.VarChar(50)
  rfq_id                 String?                 @db.Uuid
  supplier_id            String                  @db.Uuid
  product_id             String                  @db.Uuid
  supplier_part_number   String?                 @db.VarChar(100)
  offered_quantity       Decimal                 @default(1.0000) @db.Decimal(12, 4)
  unit_price             Decimal                 @db.Decimal(12, 2)
  currency               String                  @default("INR") @db.VarChar(10)
  tax_amount             Decimal                 @default(0.00) @db.Decimal(12, 2)
  shipping_amount        Decimal                 @default(0.00) @db.Decimal(12, 2)
  total_amount           Decimal                 @db.Decimal(14, 2)
  lead_time_days         Int?                    @default(7)
  minimum_order_quantity Decimal                 @default(1.0000) @db.Decimal(12, 4)
  valid_until            DateTime?               @db.Timestamptz(6)
  terms_conditions       String?                 @db.Text
  status                 SupplierQuotationStatus @default(QUOTED)
  converted_po_id        String?                 @db.Uuid
  created_by             String                  @db.Uuid
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @updatedAt @db.Timestamptz(6)

  // Relations
  rfq                RFQ?                         @relation(fields: [rfq_id], references: [id], onDelete: SetNull)
  supplier           Supplier                     @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  product            Product                      @relation(fields: [product_id], references: [id], onDelete: Restrict)
  converted_po       PurchaseOrder?               @relation(fields: [converted_po_id], references: [id], onDelete: SetNull)
  creator            User                         @relation("QuotationCreator", fields: [created_by], references: [id], onDelete: Restrict)
  negotiation_events QuotationNegotiationEvent[]

  @@index([supplier_id])
  @@index([product_id])
  @@index([rfq_id])
  @@map("supplier_quotations")
}

model QuotationNegotiationEvent {
  id              String                  @id @default(uuid()) @db.Uuid
  quotation_id    String                  @db.Uuid
  event_type      NegotiationEventType
  actor_id        String                  @db.Uuid
  offered_price   Decimal                 @db.Decimal(12, 2)
  counter_price   Decimal                 @db.Decimal(12, 2)
  currency        String                  @default("INR") @db.VarChar(10)
  message         String?                 @db.Text
  previous_status SupplierQuotationStatus
  new_status      SupplierQuotationStatus
  created_at      DateTime                @default(now()) @db.Timestamptz(6)

  // Relations
  quotation SupplierQuotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  actor     User              @relation("NegotiationActor", fields: [actor_id], references: [id], onDelete: Restrict)

  @@index([quotation_id])
  @@map("quotation_negotiation_events")
}

