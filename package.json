{
  "name": "ecoflow-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
